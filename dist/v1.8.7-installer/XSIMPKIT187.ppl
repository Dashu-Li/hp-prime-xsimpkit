  xsis:="(type((xsutree0(xsuinput,xsulevel):=BEGIN\nLOCAL xsuhead,xsulist,xsures,xsuj,xsuarg,xsupow,xsucoef,xsumat,xsufound,xsufac"+
    "t,xsuscalar,xsusafe;\nIF xsulevel>24 THEN RETURN ""XSIMP: expression depth exceeds 24""; END;\nIF size(string(xsuinput))>160"+
    "0 THEN RETURN ""XSIMP: expression exceeds 1600 characters""; END;\nIF type(xsuinput)==DOM_STRING THEN RETURN xsuinput; END;"+
