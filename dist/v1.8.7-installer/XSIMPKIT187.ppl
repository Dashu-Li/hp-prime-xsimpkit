  xsis:="(type((xsmroot(xsmvz):=BEGIN\nLOCAL xsmva,xsmvb,xsmvrho,xsmvu,xsmvv;\nIF type(xsmvz)==DOM_INT THEN RETURN sqrt(xsmvz); END"+
    ";\n\n\nIF type(xsmvz)==DOM_RAT THEN\nIF string(im(xsmvz))==""0"" THEN RETURN sqrt(xsmvz); END;\nEND;\nIF xsisapprox(xsmvz) THEN "+
    "RETURN sqrt(xsmvz); END;\nIF size(lname(xsmvz))==0 THEN\nIFERR\nxsmva:=re(xsmvz); xsmvb:=im(xsmvz);\nIF (type(xsmva)==DOM_IN"+
