    "0 THEN xsmvres[xsmvj,xsmvj]:=sin(xsmva[xsmvj,xsmvj]);\nELSE xsmvres[xsmvj,xsmvj]:=cos(xsmva[xsmvj,xsmvj]); END;\nEND;\nRETU"+
    "RN xsmclean(xsmvres);\nEND;\nxsmvmu:=xsclean(trace(xsmva)/xsmvn);\nxsmvbb:=xsmva-xsmvmu*xsmvii;\nxsmvqq:=xsclean((xsmvbb*xsm"+
