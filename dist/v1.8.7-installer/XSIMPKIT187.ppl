  xsis:="(type((xsidroot(xsie):=BEGIN\nLOCAL xsic,xsil,xsik,xsif,xsicoef,xsinn,xsidd,xsisn,xsisd,xsis,xsir,xsia;\nIF size(string(xs"+
    "ie))>256 OR xsidpoly(xsie,0,1)<>2 THEN RETURN xsphold(""sqrt(""+xspnative(xsie)+"")""); END;\nIFERR\nxsic:=factor(texpand(xsie"+
    "));\nIF xsidpoly(xsic,0,1)==0 OR xsnewapprox(xsie,xsic) THEN RETURN xsphold(""sqrt(""+xspnative(xsie)+"")""); END;\nIF NOT xsu"+
    "holegate(xsie,xsic) THEN RETURN xsphold(""sqrt(""+xspnative(xsie)+"")""); END;\nxsil:=xspflatproduct(xsic,0); xsicoef:=1; xsi"+
    "s:="""";\nFOR xsik FROM 1 TO size(xsil) DO\nxsif:=xsil[xsik];\nIF type(xsif)==DOM_INT OR type(xsif)==DOM_RAT THEN xsicoef:=xs"+
    "icoef*xsif;\nELSE\nIF xsis<>"""" THEN xsis:=xsis+""*""; END;\nxsis:=xsis+""(""+xspnative(xsif)+"")"";\nEND;\nEND;\nxsir:=xsphold(""sqrt"+
    "(""+xspnative(xsic)+"")"");\nIF xsicoef>0 THEN\nxsinn:=numer(xsicoef); xsidd:=denom(xsicoef); xsisn:=sqrt(xsinn); xsisd:=sqrt"+
    "(xsidd);\nIF type(xsisn)==DOM_INT AND type(xsisd)==DOM_INT THEN\nIF xsis=="""" THEN xsis:=""1""; END;\nxsia:=xsisn/xsisd;\nIF xs"+
    "ia==1 THEN xsir:=xsphold(""sqrt(""+xsis+"")"");\nELSE xsir:=xsphold(""(""+xspnative(xsia)+"")*sqrt(""+xsis+"")""); END;\nEND;\nEND;\nI"+
    "F NOT xsnewapprox(xsie,xsir) THEN RETURN xsir; END;\nTHEN\nRETURN xsphold(""sqrt(""+xspnative(xsie)+"")"");\nEND;\nRETURN xsphol"+
    "d(""sqrt(""+xspnative(xsie)+"")"");\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsidroot";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsidroot"; END;
  xsis:="(type((xsidmono(xsie,xsid):=BEGIN\nLOCAL xsih,xsin,xsil,xsik,xsij,xsia,xsib,xsir;\nIF xsid>=24 THEN RETURN [0]; END;\nIF ty"+
    "pe(xsie)==DOM_INT OR type(xsie)==DOM_RAT THEN RETURN [1,xsie,mid([0],1,0),mid([0],1,0)]; END;\nIF type(xsie)<>DOM_SYMBOLI"+
    "C THEN RETURN [1,1,[xsie],mid([0],1,0)]; END;\nxsih:=xshead(xsie); xsin:=string(xsih); xsil:=[op(xsie)];\nIF (xsin==""'-'"" "+
    "OR xsin==""-"") AND size(xsil)==1 THEN\nxsir:=xsidmono(xsil[1],xsid+1); IF xsir[1]==1 THEN xsir[2]:=-xsir[2]; END; RETURN x"+
    "sir;\nEND;\nIF (xsin==""'inv'"" OR xsin==""inv"") OR ((xsin==""'^'"" OR xsin==""^"") AND size(xsil)==2 AND string(xsil[2])==""-1"") "+
    "THEN\nxsia:=xsidmono(xsil[1],xsid+1); IF xsia[1]==0 OR xsia[2]==0 THEN RETURN [0]; END;\nRETURN [1,1/xsia[2],xsia[4],xsia["+
    "3]];\nEND;\nIF (xsin==""'/'"" OR xsin==""/"") AND size(xsil)==2 THEN\nxsia:=xsidmono(xsil[1],xsid+1); xsib:=xsidmono(xsil[2],xs"+
    "id+1);\nIF xsia[1]==0 OR xsib[1]==0 OR xsib[2]==0 THEN RETURN [0]; END;\nxsir:=[1,xsia[2]/xsib[2],xsia[3],xsia[4]];\nFOR xs"+
    "ij FROM 1 TO size(xsib[4]) DO xsir[3]:=append(xsir[3],xsib[4][xsij]); END;\nFOR xsij FROM 1 TO size(xsib[3]) DO xsir[4]:="+
    "append(xsir[4],xsib[3][xsij]); END;\nRETURN xsir;\nEND;\nIF xsin<>""'*'"" AND xsin<>""*"" THEN RETURN [1,1,[xsie],mid([0],1,0)]"+
    "; END;\nxsir:=[1,1,mid([0],1,0),mid([0],1,0)];\nFOR xsik FROM 1 TO size(xsil) DO\nxsia:=xsidmono(xsil[xsik],xsid+1); IF xsi"+
    "a[1]==0 THEN RETURN [0]; END;\nxsir[2]:=xsir[2]*xsia[2];\nFOR xsij FROM 1 TO size(xsia[3]) DO xsir[3]:=append(xsir[3],xsia"+
    "[3][xsij]); END;\nFOR xsij FROM 1 TO size(xsia[4]) DO xsir[4]:=append(xsir[4],xsia[4][xsij]); END;\nIF size(xsir[3])+size("+
    "xsir[4])>64 THEN RETURN [0]; END;\nEND;\nRETURN xsir;\nEND))==DOM_FUNC)";
  IFERR
