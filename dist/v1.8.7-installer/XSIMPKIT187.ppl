  xsis:="(type((xshyproots(xhpe,xhpd):=BEGIN\nLOCAL xhph,xhpn,xhpl,xhpr,xhpv,xhpk,xhpj;\nIF xhpd>=24 THEN RETURN [0]; END;\nIF type("+
    "xhpe)==DOM_INT OR type(xhpe)==DOM_RAT OR type(xhpe)==DOM_COMPLEX OR type(xhpe)==DOM_IDENT THEN RETURN [1]; END;\nIF type("+
    "xhpe)<>DOM_SYMBOLIC THEN RETURN [0]; END;\nxhph:=xshead(xhpe); xhpn:=string(xhph); xhpl:=[op(xhpe)];\nIF xhph==sqrt OR ((x"+
