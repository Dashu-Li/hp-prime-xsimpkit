  IF xsik<>1 THEN RETURN "stage:define:xsmhyperpower"; END;
  xsis:="(type((xsmpospower(xsmvbas,xsmvmu,xsmvbb,xsmvrr):=BEGIN\nLOCAL xsmvn,xsmvres,xsmvj,xsmvk,xsmvup,xsmvdn,xsmvb,xsmvc,xsmvd,"+
    "xsmvlup,xsmvldn,xsmvrational,xsmvhyp;\nxsmvn:=rowDim(xsmvbb);\nxsmvres:=0*xsmid(xsmvn);\nxsmvlup:=normal(xsmvmu+xsmvrr); xs"+
    "mvldn:=normal(xsmvmu-xsmvrr);\nxsmvrational:=1;\nIF type(xsmvlup)==DOM_INT OR type(xsmvlup)==DOM_RAT THEN\nxsmvup:=xsclean("+
    "xsmvbas^xsmvlup);\nELSE\nxsmvrational:=0;\nxsmvup:=exp(xsmvlup*ln(xsmvbas));\nEND;\nIF type(xsmvldn)==DOM_INT OR type(xsmvldn"+
    ")==DOM_RAT THEN\nxsmvdn:=xsclean(xsmvbas^xsmvldn);\nELSE\nxsmvrational:=0;\nxsmvdn:=exp(xsmvldn*ln(xsmvbas));\nEND;\nFOR xsmvj"+
    " FROM 1 TO xsmvn DO\nFOR xsmvk FROM 1 TO xsmvn DO\nxsmvb:=xsmvbb[xsmvj,xsmvk];\nIF xsmvj==xsmvk THEN\nIF xsmz(xsmvb) THEN\nxs"+
    "mvres[xsmvj,xsmvk]:=(xsmvup+xsmvdn)/2;\nELSE\nxsmvc:=xsclean((1+xsmvb/xsmvrr)/2);\nxsmvd:=xsclean((1-xsmvb/xsmvrr)/2);\nxsmv"+
    "res[xsmvj,xsmvk]:=xsmvc*xsmvup+xsmvd*xsmvdn;\nEND;\nELSE\nxsmvc:=xsclean(xsmvb/(2*xsmvrr));\nxsmvres[xsmvj,xsmvk]:=xsmvc*(xs"+
    "mvup-xsmvdn);\nEND;\nEND;\nEND;\nIF xsmvrational THEN RETURN xsmclean(xsmvres); END;\n\n\nxsmvhyp:=xsmhyperpower(xsmvbas,xsmvmu"+
    ",xsmvbb,xsmvrr);\nIF size(xsptext(xsmvhyp,0))<=size(xsptext(xsmvres,0)) THEN RETURN xsmvhyp; END;\nRETURN xsmvres;\nEND))=="+
    "DOM_FUNC)";
