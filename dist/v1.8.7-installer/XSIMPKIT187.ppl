  xsis:="(type((xsmhyperpower(xsmvbas,xsmvmu,xsmvbb,xsmvrr):=BEGIN\nLOCAL xsmvn,xsmvres,xsmvj,xsmvk,xsmvpref,xsmvu,xsmvch,xsmvsh,x"+
    "smvc,xsmvrational;\nxsmvn:=rowDim(xsmvbb);\nxsmvres:=0*xsmid(xsmvn);\nxsmvrational:=type(xsmvmu)==DOM_INT OR type(xsmvmu)=="+
    "DOM_RAT;\nIF xsmvrational THEN xsmvpref:=xsclean(xsmvbas^xsmvmu);\nELSE xsmvpref:=exp(xsmvmu*ln(xsmvbas)); END;\nxsmvu:=nor"+
    "mal(xsmvrr*ln(xsmvbas));\nxsmvch:=cosh(xsmvu); xsmvsh:=sinh(xsmvu);\nFOR xsmvj FROM 1 TO xsmvn DO\nFOR xsmvk FROM 1 TO xsmv"+
    "n DO\nxsmvc:=xsclean(xsmvbb[xsmvj,xsmvk]/xsmvrr);\nIF xsmvj==xsmvk THEN\nxsmvres[xsmvj,xsmvk]:=xsmvpref*(xsmvch+xsmvc*xsmvs"+
    "h);\nELSE\nIF xsmvrational THEN xsmvc:=xsclean(xsmvpref*xsmvc);\nELSE xsmvc:=xsmvpref*xsmvc; END;\nxsmvres[xsmvj,xsmvk]:=xsm"+
    "vc*xsmvsh;\nEND;\nEND;\nEND;\nRETURN xsmvres;\nEND))==DOM_FUNC)";
