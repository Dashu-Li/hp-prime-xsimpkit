  IF xsik<>1 THEN RETURN "stage:define:xsuholegate"; END;
  xsis:="(type((xsuend(xsue):=BEGIN\nLOCAL xsuc,xsuo,xsuraw,xsusafe;\nxsusafe:=xsidauto(xsue);\nIF xsusafe[2] THEN RETURN xsusafe[1]"+
