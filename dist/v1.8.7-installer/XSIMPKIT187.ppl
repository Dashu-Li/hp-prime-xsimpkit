  xsis:="(type((xspfpoly(xspfe,xspfd):=BEGIN\nLOCAL xspfbest,xspff,xspfh,xspfn,xspfl,xspfnew,xspfv,xspfvars,xspfdeg,xspfk,xspfj,xs"+
    "pfcoef,xspfs,xspft,xspfchanged,xspfcount;\nIF xspfd>2 OR size(string(xspfe))>512 OR type(xspfe)<>DOM_SYMBOLIC THEN RETURN"+
    " xspfe; END;\nIF xsidpoly(xspfe,0,0)<>1 THEN RETURN xspfe; END;\nxspfvars:=lname(xspfe);\nIF size(xspfvars)>5 THEN RETURN x"+
    "spfe; END;\nxspfbest:=xspfe;\nIFERR\nxspff:=factor(xspfe);\nIF size(string(xspff))<size(string(xspfbest)) AND xspfcheck(xspf"+
    "e,xspff) THEN xspfbest:=xspff; END;\n\n\nxspfh:=xshead(xspff); xspfn:=string(xspfh); xspfl:=[op(xspff)];\nIF (xspfn==""'*'"" O"+
    "R xspfn==""*"") AND xspfd<2 AND size(xspfl)<=8 THEN\nxspfchanged:=0;\nFOR xspfk FROM 1 TO size(xspfl) DO\nIF type(xspfl[xspfk"+
    "])==DOM_SYMBOLIC THEN\nxspfn:=string(xshead(xspfl[xspfk]));\nIF (xspfn==""'+'"" OR xspfn==""+"" OR xspfn==""'-'"" OR xspfn==""-"")"+
    " AND size([op(xspfl[xspfk])])>=3 THEN\nxspfnew:=xspfpoly(xspfl[xspfk],xspfd+1);\nIF string(xspfnew)<>string(xspfl[xspfk]) "+
    "THEN xspfl[xspfk]:=xspfnew; xspfchanged:=1; END;\nEND;\nEND;\nEND;\nIF xspfchanged THEN\nxspfnew:=xshyprebuild(xspfh,xspfl);\n"+
    "IF size(string(xspfnew))<size(string(xspfbest)) AND xspfcheck(xspfe,xspfnew) THEN xspfbest:=xspfnew; END;\nEND;\nEND;\n\n\n\nx"+
    "spfn:=string(xshead(xspfe));\nIF xspfn<>""'+'"" AND xspfn<>""+"" AND xspfn<>""'-'"" AND xspfn<>""-"" THEN RETURN xspfbest; END;\nI"+
    "F size([op(xspfe)])<3 THEN RETURN xspfbest; END;\nFOR xspfj FROM 1 TO size(xspfvars) DO\nxspfv:=xspfvars[xspfj]; xspfdeg:="+
    "degree(xspfe,xspfv);\nIF type(xspfdeg)==DOM_INT AND xspfdeg>=1 AND xspfdeg<=4 THEN\nxspfs:=""""; xspfcount:=0;\nFOR xspfk FRO"+
    "M 0 TO xspfdeg DO\nxspfcoef:=coeff(xspfe,xspfv,xspfk);\nIF string(xspfcoef)<>""0"" THEN\nIF type(xspfcoef)==DOM_SYMBOLIC THEN"+
    " xspfcoef:=factor(xspfcoef); END;\nIF xsidpoly(xspfcoef,0,0)<>1 THEN RETURN xspfbest; END;\nxspft:=""(""+xspnative(xspfcoef)"+
    "+"")"";\nIF xspfk>0 THEN\nIF string(xspfcoef)==""1"" THEN xspft:=""(""+xspnative(xspfv)+"")"";\nELSE xspft:=xspft+""*(""+xspnative(xs"+
    "pfv)+"")""; END;\nIF xspfk>1 THEN xspft:=xspft+""^""+string(xspfk); END;\nEND;\nIF xspfs<>"""" THEN xspfs:=xspfs+""+""; END;\nxspfs:"+
    "=xspfs+xspft; xspfcount:=xspfcount+1;\nEND;\nEND;\nIF xspfcount>0 THEN\nxspfnew:=xshyphold(xspfs);\nIF size(string(xspfnew))<"+
