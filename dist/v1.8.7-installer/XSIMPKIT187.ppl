  xsis:="(type((xsuholegate(xsuprior,xsunext):=BEGIN\nLOCAL xsuold,xsunew,xsuprod,xsuk,xsuj,xsuv,xsumatch,xsukey,xsuallmatch,xsude"+
    "n;\nIFERR\nxsuold:=xsuholewalk(xsuprior,0,2048); IF xsuold[1]==0 THEN RETURN 0; END;\nIF size(xsuold[3])==0 THEN RETURN 1; "+
    "END;\nxsunew:=xsuholewalk(xsunext,0,2048); IF xsunew[1]==0 THEN RETURN 0; END;\n\nxsuallmatch:=1;\nFOR xsuk FROM 1 TO size(x"+
    "suold[3]) DO\nxsumatch:=0;\nFOR xsuj FROM 1 TO size(xsunew[3]) DO\nIF string(xsuold[3][xsuk])==string(xsunew[3][xsuj]) THEN"+
    " xsumatch:=1; END;\nEND;\nIF NOT xsumatch THEN xsuallmatch:=0; END;\nEND;\nIF xsuallmatch THEN RETURN 1; END;\nxsuprod:=1;\nFO"+
    "R xsuk FROM 1 TO size(xsunew[3]) DO\nIF xshyppoly(xsunew[3][xsuk],0) THEN\nIF NOT xsmpunbound(xsunew[3][xsuk],0) THEN RETU"+
    "RN 0; END;\nxsuprod:=xsuprod*xsunew[3][xsuk];\nIF size(string(xsuprod))>1600 THEN RETURN 0; END;\nEND;\nEND;\nFOR xsuk FROM 1"+
    " TO size(xsuold[3]) DO\nxsuv:=xsuold[3][xsuk];\nIF xshyppoly(xsuv,0) THEN\nIF NOT xsmpunbound(xsuv,0) THEN RETURN 0; END;\n\n"+
    "\n\nxsuden:=denom(ratnormal(xsuprod/xsuv));\nIF (type(xsuden)<>DOM_INT AND type(xsuden)<>DOM_RAT) OR xsuden==0 THEN RETURN "+
    "0; END;\nELSE\nxsukey:=xsptext(xsuv,0); xsumatch:=0;\nFOR xsuj FROM 1 TO size(xsunew[3]) DO\nIF string(xsunew[3][xsuj])==str"+
