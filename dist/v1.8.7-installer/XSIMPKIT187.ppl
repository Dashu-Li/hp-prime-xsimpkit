    RETURN "stage:define:xsidmono";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsidmono"; END;
  xsis:="(type((xsidwalk(xsie,xsid):=BEGIN\nLOCAL xsit,xsih,xsin,xsil,xsik,xsiv,xsir,xsiflag,xsiarg,xsic,xsim,xsinn,xsidd,xsis,xsi"+
    "a,xsichanged;\nxsit:=type(xsie); xsiflag:=0;\nIF xsid>=24 OR size(string(xsie))>1600 THEN RETURN [xsie,0]; END;\nIF xsit==D"+
    "OM_LIST THEN\nxsir:=xsie;\nFOR xsik FROM 1 TO size(xsie) DO\nxsiv:=xsidwalk(xsie[xsik],xsid+1); xsir[xsik]:=xsiv[1];\nIF xsi"+
    "v[2] THEN xsiflag:=1; END;\nEND;\nRETURN [xsir,xsiflag];\nEND;\nIF xsit<>DOM_SYMBOLIC THEN RETURN [xsie,0]; END;\nxsih:=xshea"+
    "d(xsie); xsin:=string(xsih); xsil:=[op(xsie)];\nIF xsin==""of"" OR xsin==""'of'"" THEN RETURN [xsie,0]; END;\n\n\n\nFOR xsik FROM"+
    " 1 TO size(xsil) DO IF type(xsil[xsik])==DOM_LIST THEN RETURN [xsie,0]; END; END;\n\n\nIF (xsin==""'^'"" OR xsin==""^"") AND si"+
    "ze(xsil)==2 THEN\nIF type(xsil[2])<>DOM_INT AND xshypnatural(xsil[1]) THEN RETURN [xsie,1]; END;\nEND;\nIF xsih==sqrt OR (("+
    "xsin==""'^'"" OR xsin==""^"") AND size(xsil)==2 AND string(xsil[2])==""1/2"") THEN\nxsiarg:=xsil[1]; xsis:=string(xsiarg);\nIF x"+
    "shypnatural(xsiarg) THEN RETURN [xsie,1]; END;\nIF size(lname(xsiarg))>0 AND (inString(xsis,""sin"")>0 OR inString(xsis,""co"+
    "s"")>0 OR inString(xsis,""SIN"")>0 OR inString(xsis,""COS"")>0) THEN\nxsiflag:=1; xsir:=xsidroot(xsiarg);\nIF size(string(xsir)"+
    ")<size(string(xsie)) AND NOT xsnewapprox(xsie,xsir) AND xsuholegate(xsie,xsir) THEN RETURN [xsir,1]; END;\nRETURN [xsie,1"+
    "];\nEND;\nEND;\nxsir:=xsie; xsichanged:=0;\nFOR xsik FROM 1 TO size(xsil) DO\nIF string(xsil[xsik])==string(xsie) THEN RETURN"+
    " [xsie,xsiflag]; END;\nxsiv:=xsidwalk(xsil[xsik],xsid+1);\nIF xsiv[2] THEN xsiflag:=1; END;\nIF string(xsiv[1])<>string(xsi"+
    "l[xsik]) THEN xsir[xsik+1]:=xsiv[1]; xsichanged:=1; END;\nEND;\nxsil:=[op(xsir)];\nIF (xsin==""'^'"" OR xsin==""^"") AND size(x"+
    "sil)==2 AND type(xsil[2])==DOM_INT THEN\nIF xshypnatural(xsil[1]) THEN\nxsiarg:=xshyparg(xsil[1]);\nIF xsidpoly(xsiarg,0,2)"+
    ">0 THEN\nxsic:=xsphold(""(""+xspnative(xsil[2])+"")*(""+xspnative(xsiarg)+"")"");\nxsia:=ratnormal(eval(xsic));\nIF NOT xsnewappr"+
    "ox(xsic,xsia) AND xsuholegate(xsic,xsia) THEN xsic:=xsia; END;\nxsia:=xsphold(""exp(""+xspnative(xsic)+"")"");\nIF NOT xsnewap"+
    "prox(xsir,xsia) AND xsuholegate(xsir,xsia) THEN RETURN [xsia,xsiflag]; END;\nEND;\nEND;\nEND;\nIF xsiflag OR xsichanged THEN"+
    "\nIF member(xsin,[""'*'"",""*"",""'/'"",""/"",""'inv'"",""inv""]) THEN\nxsim:=xsidmono(xsir,0);\nIF xsim[1] THEN\nxsinn:=""""; xsidd:="""";\n"+
    "IF numer(xsim[2])<>1 OR size(xsim[3])==0 THEN xsinn:=xspnative(numer(xsim[2])); END;\nIF denom(xsim[2])<>1 THEN xsidd:=xs"+
    "pnative(denom(xsim[2])); END;\nFOR xsik FROM 1 TO size(xsim[3]) DO\nIF xsinn<>"""" THEN xsinn:=xsinn+""*""; END;\nxsinn:=xsinn+"+
    """(""+xspnative(xsim[3][xsik])+"")"";\nEND;\nFOR xsik FROM 1 TO size(xsim[4]) DO\nIF xsidd<>"""" THEN xsidd:=xsidd+""*""; END;\nxsid"+
    "d:=xsidd+""(""+xspnative(xsim[4][xsik])+"")"";\nEND;\nIF xsidd=="""" THEN xsia:=xsphold(xsinn);\nELSE xsia:=xsphold(""(""+xsinn+"")/"+
    "(""+xsidd+"")""); END;\nIF NOT xsnewapprox(xsir,xsia) AND xsuholegate(xsir,xsia) AND size(string(xsia))<size(string(xsir)) T"+
    "HEN xsir:=xsia; END;\nEND;\nEND;\nEND;\nRETURN [xsir,xsiflag];\nEND))==DOM_FUNC)";
