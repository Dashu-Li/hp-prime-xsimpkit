  xsis:="(type((xshypcompact(xhpe):=BEGIN\nLOCAL xhpoldholes,xhpnewholes,xhpprod,xhpk,xhpv,xhpr,xhptext,xhpden;\nIF type(xhpe)<>DOM"+
