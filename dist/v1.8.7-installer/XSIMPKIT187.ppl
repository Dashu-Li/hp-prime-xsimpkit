    "xsvr,xsvk,xsvtrig,xsvangle,xsvrlen,xsvtlen;\nIF size(xsva)<1 OR size(xsva)>2 THEN RETURN xsve; END;\nIFERR\n\n\nxsvz:=expr(""q"+
