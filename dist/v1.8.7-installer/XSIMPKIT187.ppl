  IF xsik<>1 THEN RETURN "stage:define:xsmpospower"; END;
  xsis:="(type((xsmcore(xsmva,xsmvt,xsmvbas,xsmvkind):=BEGIN\nLOCAL xsmvn,xsmvii,xsmvmu,xsmvbb,xsmvqq,xsmvrr,xsmvcc,xsmvdd,xsmvpre"+
    "f,xsmvj,xsmvk,xsmvpp,xsmvtotal,xsmvup,xsmvdn,xsmvres,xsmvtheta;\nxsmvn:=rowDim(xsmva);\nIF xsmvn!=colDim(xsmva) THEN RETUR"+
    "N ""XEXP/XPOW requires a square matrix""; END;\nxsmvii:=xsmid(xsmvn);\nIF xsmdiagonal(xsmva) THEN\nxsmvres:=0*xsmvii;\nFOR xsm"+
    "vj FROM 1 TO xsmvn DO\nIF xsmvkind==1 THEN xsmvres[xsmvj,xsmvj]:=xsmvbas^xsmva[xsmvj,xsmvj];\nELSE xsmvres[xsmvj,xsmvj]:=e"+
    "xp(xsmvt*xsmva[xsmvj,xsmvj]); END;\nEND;\nRETURN xsmclean(xsmvres);\nEND;\nxsmvmu:=xsclean(trace(xsmva)/xsmvn);\nxsmvbb:=xsmv"+
    "a-xsmvmu*xsmvii;\nxsmvqq:=xsclean((xsmvbb*xsmvbb)[1,1]);\nIF xsmvkind==1 THEN xsmvpref:=xsmvbas^xsmvmu;\nELSE xsmvpref:=exp"+
    "(xsmvt*xsmvmu); END;\nIF xsmzero(xsmvbb*xsmvbb-xsmvqq*xsmvii) THEN\nIF xsmz(xsmvqq) THEN RETURN xsmclean(xsmvpref*(xsmvii+"+
    "xsmvt*xsmvbb)); END;\nIF size(lname(xsmvqq))!=0 THEN\nRETURN xsmclean(exp(xsmvt*xsmva));\nEND;\nIF xsmsign(xsmvqq)==-1 THEN\n"+
    "xsmvrr:=sqrt(-xsmvqq);\nxsmvcc:=cos(xsmvt*xsmvrr);\nxsmvdd:=sin(xsmvt*xsmvrr)/xsmvrr;\nRETURN xsmclean(xsmvpref*(xsmvcc*xsm"+
    "vii+xsmvdd*xsmvbb));\nEND;\nIF xsmsign(xsmvqq)==1 THEN\nxsmvrr:=sqrt(xsmvqq);\nIF xsmvkind==1 THEN\nRETURN xsmpospower(xsmvba"+
    "s,xsmvmu,xsmvbb,xsmvrr);\nEND;\n\n\nIF xsmz(re(xsmvt)) THEN\nxsmvtheta:=normal(-i*xsmvt*xsmvrr);\nRETURN xsmclean(xsmvpref*(co"+
    "s(xsmvtheta)*xsmvii+i*sin(xsmvtheta)/xsmvrr*xsmvbb));\nEND;\nRETURN xsmhyperexp(xsmvt,xsmvmu,xsmvbb,xsmvrr);\nEND;\n\nxsmvrr:"+
    "=xsmroot(-xsmvqq);\nxsmvcc:=cos(xsmvt*xsmvrr);\nxsmvdd:=sin(xsmvt*xsmvrr)/xsmvrr;\nRETURN xsmclean(xsmvpref*(xsmvcc*xsmvii+"+
    "xsmvdd*xsmvbb));\nEND;\n\nxsmvpp:=xsmvii; xsmvtotal:=xsmvii;\nFOR xsmvj FROM 1 TO xsmvn DO\nxsmvpp:=xsmvpp*xsmvbb;\nIF xsmzero"+
    "(xsmvpp) THEN RETURN xsmclean(xsmvpref*xsmvtotal); END;\nxsmvtotal:=xsmvtotal+xsmvt^xsmvj/xsmvj!*xsmvpp;\nEND;\n\nRETURN xsm"+
    "clean(exp(xsmvt*xsmva));\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
