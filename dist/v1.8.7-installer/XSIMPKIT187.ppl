    "END;\nxsmvrho:=sqrt(xsmva^2+xsmvb^2);\nxsmvu:=sqrt(ratnormal((xsmvrho+xsmva)/2));\nxsmvv:=sqrt(ratnormal((xsmvrho-xsmva)/2)"+
    ");\nIF xsmvb<0 THEN xsmvv:=-xsmvv; END;\nRETURN xsmvu+i*xsmvv;\nEND;\n\nIF string(xsmvb)==""0"" THEN RETURN sqrt(xsmvz); END;\nT"+
    "HEN\nRETURN xsphold(""sqrt(""+xspnative(xsmvz)+"")"");\nEND;\nEND;\nRETURN xsphold(""sqrt(""+xspnative(xsmvz)+"")"");\nEND))==DOM_FUN"+
