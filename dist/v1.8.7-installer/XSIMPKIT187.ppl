EXPORT XSIMPKIT187()
BEGIN
  LOCAL xsis,xsik;
  xsis:="of:=1";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:index:set";
  END;
  xsis:="([17,23])[1]==17";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:index:verify";
  END;
  IF xsik<>1 THEN RETURN "stage:index:verify"; END;
  xsis:="(type((xshead(xsve):=BEGIN RETURN xsve[1]; END))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xshead";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xshead"; END;
  xsis:="(type((xsinitok(xsinitunused):=BEGIN\nLOCAL xsinitlist;\nIFERR\nIF NOT expr(""([17,23])[1]==17"") THEN RETURN 0; END;\nxsinitl"+
    "ist:=[];\nxsinitlist:=append(xsinitlist,17);\nRETURN string(xsinitlist)==""[17]"";\nTHEN RETURN 0;\nEND;\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsinitok";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsinitok"; END;
  xsis:="(type((xsapproxstate(xsve,xsvdepth):=BEGIN\nLOCAL xsvt,xsvl,xsvk,xsvs,xsvr,xsvtext;\nxsvt:=type(xsve);\nIF xsvt==DOM_FLOAT "+
    "THEN RETURN 1; END;\nIF xsvt==DOM_COMPLEX THEN\nIF type(re(xsve))==DOM_FLOAT OR type(im(xsve))==DOM_FLOAT THEN RETURN 1; E"+
    "ND;\nRETURN 0;\nEND;\nIF xsvt<>DOM_SYMBOLIC AND xsvt<>DOM_LIST THEN RETURN 0; END;\nxsvtext:=string(xsve);\nIF inString(xsvte"+
    "xt,""."")==0 AND inString(xsvtext,""E"")==0 AND\ninString(xsvtext,""e"")==0 AND inString(xsvtext,""inf"")==0 AND\ninString(xsvtext"+
    ",""nan"")==0 THEN RETURN 0; END;\nIF xsvdepth>=24 THEN RETURN 2; END;\nIF xsvt==DOM_LIST THEN xsvl:=xsve; ELSE xsvl:=[op(xsv"+
    "e)]; END;\nxsvr:=0;\nFOR xsvk FROM 1 TO size(xsvl) DO\nIF string(xsvl[xsvk])==xsvtext THEN xsvs:=2;\nELSE xsvs:=xsapproxstat"+
    "e(xsvl[xsvk],xsvdepth+1); END;\nIF xsvs==1 THEN RETURN 1; END;\nIF xsvs==2 THEN xsvr:=2; END;\nEND;\nRETURN xsvr;\nEND))==DOM"+
    "_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsapproxstate";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsapproxstate"; END;
  xsis:="(type((xsisapprox(xsve):=BEGIN RETURN xsapproxstate(xsve,0)==1; END))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsisapprox";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsisapprox"; END;
  xsis:="(type((xsnewapprox(xsve,xsvc):=BEGIN\nIF xsapproxstate(xsvc,0)==0 THEN RETURN 0; END;\nIF xsisapprox(xsve) THEN RETURN 0; "+
    "END;\nRETURN 1;\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsnewapprox";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsnewapprox"; END;
  xsis:="(type((xscomplexradwalk(xsve,xsvdepth):=BEGIN\nLOCAL xsvt,xsvh,xsvl,xsvk,xsvs,xsvimag,xsvrad,xsvparent;\nxsvt:=type(xsve);"+
    "\nIF xsvt==DOM_COMPLEX OR xsvt==DOM_RAT THEN\nIF string(im(xsve))<>""0"" THEN RETURN 1; END;\nRETURN 0;\nEND;\nIF xsvt<>DOM_SYM"+
    "BOLIC AND xsvt<>DOM_LIST THEN RETURN 0; END;\nIF xsvdepth>=24 THEN RETURN 0; END;\nxsvimag:=0; xsvrad:=0;\nIF xsvt==DOM_LIS"+
    "T THEN xsvl:=xsve;\nELSE\nxsvh:=xshead(xsve); xsvl:=[op(xsve)];\nIF xsvh==sqrt THEN xsvrad:=1; END;\nIF string(xsvh)==""'^'"" "+
    "OR string(xsvh)==""^"" THEN\nIF size(xsvl)==2 THEN\nIF type(xsvl[2])==DOM_RAT AND string(im(xsvl[2]))==""0"" THEN xsvrad:=1; E"+
    "ND;\nEND;\nEND;\nEND;\nxsvparent:=string(xsve);\nFOR xsvk FROM 1 TO size(xsvl) DO\nIF string(xsvl[xsvk])<>xsvparent THEN\nxsvs:"+
    "=xscomplexradwalk(xsvl[xsvk],xsvdepth+1);\nIF xsvs==1 OR xsvs==3 THEN xsvimag:=1; END;\nIF xsvs==2 OR xsvs==3 THEN xsvrad:"+
    "=1; END;\nIF xsvimag AND xsvrad THEN RETURN 3; END;\nEND;\nEND;\nRETURN xsvimag+2*xsvrad;\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xscomplexradwalk";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xscomplexradwalk"; END;
  xsis:="(type((xscomplexrad(xsve):=BEGIN\nIF type(xsve)<>DOM_SYMBOLIC AND type(xsve)<>DOM_LIST THEN RETURN 0; END;\nIF size(lname("+
    "xsve))<>0 THEN RETURN 0; END;\nIF xscomplexradwalk(xsve,0)<>3 THEN RETURN 0; END;\nIF xsisapprox(xsve) THEN RETURN 0; END;"+
    "\nRETURN 1;\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xscomplexrad";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xscomplexrad"; END;
  xsis:="(type((xsradtrigsquare(xsve):=BEGIN\nLOCAL xsvh,xsvl,xsvb;\nIF type(xsve)<>DOM_SYMBOLIC THEN RETURN mid([0],1,0); END;\nxsv"+
    "h:=string(xshead(xsve));\nIF xsvh<>""'^'"" AND xsvh<>""^"" THEN RETURN mid([0],1,0); END;\nxsvl:=[op(xsve)];\nIF size(xsvl)<>2 "+
    "THEN RETURN mid([0],1,0); END;\nIF type(xsvl[2])<>DOM_INT OR xsvl[2]<>2 THEN RETURN mid([0],1,0); END;\nxsvb:=xsvl[1];\nIF "+
    "type(xsvb)<>DOM_SYMBOLIC THEN RETURN mid([0],1,0); END;\nxsvh:=xshead(xsvb);\nIF xsvh==sin THEN RETURN [1,op(xsvb)]; END;\n"+
    "IF xsvh==cos THEN RETURN [2,op(xsvb)]; END;\nRETURN mid([0],1,0);\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsradtrigsquare";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsradtrigsquare"; END;
  xsis:="(type((xsradtrigunit(xsve):=BEGIN\nLOCAL xsvh,xsvl,xsvk,xsvj,xsva,xsvb,xsvhit,xsvchanged,xsvr;\nIF type(xsve)<>DOM_SYMBOLI"+
    "C THEN RETURN xsve; END;\nxsvh:=string(xshead(xsve));\nIF xsvh<>""'+'"" AND xsvh<>""+"" THEN RETURN xsve; END;\nxsvl:=[op(xsve)"+
    "];\nIF size(xsvl)>32 THEN RETURN xsve; END;\nxsvchanged:=0;\nFOR xsvk FROM 1 TO size(xsvl) DO\nxsva:=xsradtrigsquare(xsvl[xs"+
    "vk]);\nIF size(xsva)==2 THEN\nxsvhit:=0;\nFOR xsvj FROM xsvk+1 TO size(xsvl) DO\nIF NOT xsvhit THEN\nxsvb:=xsradtrigsquare(xs"+
    "vl[xsvj]);\nIF size(xsvb)==2 THEN\nIF xsva[1]<>xsvb[1] AND string(xsva[2])==string(xsvb[2]) THEN\nxsvl[xsvk]:=1; xsvl[xsvj]"+
    ":=0; xsvhit:=1; xsvchanged:=1;\nEND;\nEND;\nEND;\nEND;\nEND;\nEND;\nIF NOT xsvchanged THEN RETURN xsve; END;\nxsvr:=0;\nFOR xsvk "+
    "FROM 1 TO size(xsvl) DO xsvr:=xsvr+xsvl[xsvk]; END;\nIF xsnewapprox(xsve,xsvr) THEN RETURN xsve; END;\nRETURN xsvr;\nEND))="+
    "=DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsradtrigunit";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsradtrigunit"; END;
  xsis:="(type((xspos(xsve):=BEGIN\nIF type(xsve)==DOM_INT OR type(xsve)==DOM_RAT THEN RETURN xsve>0; END;\nIF size(lname(xsve))!=0"+
    " THEN RETURN 0; END;\nIF string(simplify(im(xsve)))!=""0"" THEN RETURN 0; END;\nRETURN string(simplify(sign(xsve)))==""1"";\nEN"+
    "D))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xspos";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xspos"; END;
  xsis:="(type((xslogswalk(xsve,xsvdepth):=BEGIN\nLOCAL xsvl,xsvr,xsvk,xsvj,xsva,xsvparent,xsvh;\nxsvr:=mid([0],1,0);\nIF xsvdepth>="+
    "24 THEN RETURN xsvr; END;\n\n\nxsvparent:=string(xsve);\nIF inString(xsvparent,""ln"")==0 AND inString(xsvparent,""LN"")==0 AND\n"+
    "inString(xsvparent,""log"")==0 AND inString(xsvparent,""LOG"")==0 THEN RETURN xsvr; END;\nIF type(xsve)==DOM_LIST THEN xsvl:="+
    "xsve;\nELSE\nIF type(xsve)<>DOM_SYMBOLIC THEN RETURN xsvr; END;\nxsvh:=xshead(xsve);\nIF type(xsvh)<>DOM_FUNC THEN RETURN xs"+
    "vr; END;\nIF string(xsvh)==""'of'"" OR string(xsvh)==""of"" THEN RETURN xsvr; END;\nIF xsvh==ln THEN RETURN [xsve]; END;\nxsvl:"+
    "=[op(xsve)];\nEND;\nFOR xsvk FROM 1 TO size(xsvl) DO\nIF string(xsvl[xsvk])<>xsvparent THEN\nxsva:=xslogswalk(xsvl[xsvk],xsv"+
    "depth+1);\nFOR xsvj FROM 1 TO size(xsva) DO\nIF NOT member(xsva[xsvj],xsvr) THEN\nxsvr:=append(xsvr,xsva[xsvj]);\nEND;\nEND;\n"+
    "END;\nEND;\nRETURN xsvr;\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xslogswalk";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xslogswalk"; END;
  xsis:="(type((xslogs(xsve):=BEGIN RETURN xslogswalk(xsve,0); END))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xslogs";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xslogs"; END;
  xsis:="(type((xshyppoly(xhpe,xhpd):=BEGIN\nLOCAL xhph,xhpl,xhpk;\nIF xhpd>=20 THEN RETURN 0; END;\nIF type(xhpe)==DOM_INT OR type("+
    "xhpe)==DOM_RAT OR type(xhpe)==DOM_COMPLEX OR type(xhpe)==DOM_IDENT THEN RETURN 1; END;\nIF type(xhpe)<>DOM_SYMBOLIC THEN "+
    "RETURN 0; END;\nxhph:=string(xshead(xhpe)); xhpl:=[op(xhpe)];\nIF xhph==""'^'"" OR xhph==""^"" THEN\nIF size(xhpl)<>2 OR type(x"+
    "hpl[2])<>DOM_INT OR xhpl[2]<0 OR xhpl[2]>8 THEN RETURN 0; END;\nRETURN xshyppoly(xhpl[1],xhpd+1);\nEND;\nIF NOT member(xhph"+
    ",[""'+'"",""+"",""'-'"",""-"",""'*'"",""*""]) THEN RETURN 0; END;\nFOR xhpk FROM 1 TO size(xhpl) DO IF NOT xshyppoly(xhpl[xhpk],xhpd+"+
    "1) THEN RETURN 0; END; END;\nRETURN 1;\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xshyppoly";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xshyppoly"; END;
  xsis:="(type((xsrwwalk(xsve,xsvdepth):=BEGIN\nLOCAL xsvl,xsvr,xsvk,xsvu,xsvb,xsvc,xsvq,xsvparent,xsvh,xsvt,xsvheadtext;\nIF xsvde"+
    "pth>=24 THEN RETURN xsve; END;\n\n\nxsvt:=type(xsve);\nIF xsvt<>DOM_LIST AND xsvt<>DOM_SYMBOLIC THEN RETURN xsve; END;\nIF xs"+
    "vt==DOM_SYMBOLIC AND xshyppoly(xsve,0) THEN RETURN xsve; END;\nxsvparent:=string(xsve);\nIF xsvt==DOM_LIST THEN\nxsvr:=mid("+
    "[0],1,0);\nFOR xsvk FROM 1 TO size(xsve) DO\nIF string(xsve[xsvk])==xsvparent THEN\nxsvr:=append(xsvr,xsve[xsvk]);\nELSE\nxsv"+
    "r:=append(xsvr,xsrwwalk(xsve[xsvk],xsvdepth+1));\nEND;\nEND;\nRETURN xsvr;\nEND;\nxsvh:=xshead(xsve);\nIF type(xsvh)<>DOM_FUNC"+
    " THEN RETURN xsve; END;\n\n\nxsvheadtext:=string(xsvh);\nIF xsvheadtext==""'of'"" OR xsvheadtext==""of"" THEN RETURN xsve; END;\n"+
    "xsvl:=[op(xsve)]; xsvr:=mid([0],1,0);\nFOR xsvk FROM 1 TO size(xsvl) DO\nIF string(xsvl[xsvk])==xsvparent THEN\nxsvr:=appen"+
    "d(xsvr,xsvl[xsvk]);\nELSE\nxsvr:=append(xsvr,xsrwwalk(xsvl[xsvk],xsvdepth+1));\nEND;\nEND;\n\n\nIF string(xsvr)==string(xsvl) T"+
    "HEN xsvq:=xsve;\nELSE\nxsvq:=xsvh(op(xsvr));\nIF xsnewapprox(xsve,xsvq) THEN RETURN xsve; END;\nEND;\nIF type(xsvq)<>DOM_SYMB"+
    "OLIC THEN RETURN xsvq; END;\nxsvh:=xshead(xsvq);\nxsvheadtext:=string(xsvh);\nIF xsvheadtext==""'^'"" OR xsvheadtext==""^"" THE"+
    "N\nxsvl:=[op(xsvq)];\nIF size(xsvl)==2 THEN\nxsvb:=xsvl[1]; xsvc:=xsvl[2];\nIF type(xsvb)<>DOM_LIST AND type(xsvc)<>DOM_LIST"+
    " THEN\n\nIF type(xsvc)==DOM_INT THEN RETURN xsvq; END;\nIF type(xsvc)==DOM_RAT AND string(im(xsvc))==""0"" THEN RETURN xsvq; "+
    "END;\nIF xspos(xsvb) THEN\nIF string(simplify(im(xsvc)))!=""0"" THEN\nxsvr:=exp(ln(xsvb)*xsvc);\nIF xsnewapprox(xsvq,xsvr) THE"+
    "N RETURN xsvq; END;\nRETURN xsvr;\nEND;\nEND;\nEND;\nEND;\nEND;\nIF xsvh<>exp THEN RETURN xsvq; END;\nxsvu:=op(xsvq); xsvl:=xslo"+
    "gs(xsvu);\nFOR xsvk FROM 1 TO size(xsvl) DO\nxsvb:=op(xsvl[xsvk]);\nIF xspos(xsvb) AND xsvb<>1 THEN\nxsvc:=normal(xsvu/xsvl["+
    "xsvk]);\nIF NOT xsnewapprox(xsvu,xsvc) AND size(xslogs(xsvc))==0 THEN\nIF string(simplify(im(xsvc)))==""0"" THEN\nxsvr:=xsvb^"+
    "xsvc;\nIF xsnewapprox(xsvq,xsvr) THEN RETURN xsvq; END;\nRETURN xsvr;\nEND;\nEND;\nEND;\nEND;\nRETURN xsvq;\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsrwwalk";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsrwwalk"; END;
  xsis:="(type((xsrewrite(xsve):=BEGIN RETURN xsrwwalk(xsve,0); END))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsrewrite";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsrewrite"; END;
  xsis:="(type((xsweightwalk(xsve,xsvdepth):=BEGIN\nLOCAL xsvl,xsvk,xsvw,xsvh,xsvparent,xsvt,xsvheadtext;\nIF xsvdepth>=24 THEN RET"+
    "URN 1000; END;\nxsvw:=1;\nxsvt:=type(xsve);\nIF xsvt==DOM_LIST THEN xsvl:=xsve;\nELSE\nIF xsvt<>DOM_SYMBOLIC THEN RETURN 1; E"+
    "ND;\nxsvh:=xshead(xsve);\nIF type(xsvh)<>DOM_FUNC THEN RETURN size(string(xsve)); END;\nxsvheadtext:=string(xsvh);\nIF xsvhe"+
    "adtext==""'of'"" OR xsvheadtext==""of"" THEN RETURN size(string(xsve)); END;\nIF xsvh==re OR xsvh==im OR xsvh==arg THEN xsvw:"+
    "=12; END;\nIF xsvh==sin OR xsvh==cos THEN xsvw:=3; END;\nxsvl:=[op(xsve)];\nEND;\nxsvparent:=string(xsve);\nFOR xsvk FROM 1 T"+
    "O size(xsvl) DO\nIF string(xsvl[xsvk])==xsvparent THEN\nxsvw:=xsvw+1000;\nELSE\nxsvw:=xsvw+xsweightwalk(xsvl[xsvk],xsvdepth+"+
    "1);\nEND;\nEND;\nRETURN xsvw;\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsweightwalk";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsweightwalk"; END;
  xsis:="(type((xsweight(xsve):=BEGIN RETURN xsweightwalk(xsve,0); END))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsweight";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsweight"; END;
  xsis:="(type((xsscore(xsve):=BEGIN RETURN 20*xsweight(xsve)+size(string(xsve)); END))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsscore";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsscore"; END;
  xsis:="(type((xstrans(xsve,xsvk):=BEGIN\nLOCAL xsvr;\nxsvr:=xsve;\nIFERR\nIF xsvk==1 THEN xsvr:=simplify(xsve); END;\nIF xsvk==2 THE"+
    "N xsvr:=normal(xsve); END;\nIF xsvk==5 THEN\nxsvr:=trig2exp(xsve);\nIF string(xsvr)==string(xsve) THEN RETURN """"; END;\nxsvr"+
    ":=simplify(xsvr);\nEND;\nIF xsvk==6 THEN\nIF size(lname(xsve))!=0 THEN RETURN """"; END;\nxsvr:=exp2trig(xsve);\nIF string(xsvr"+
    ")==string(xsve) THEN RETURN """"; END;\nxsvr:=simplify(xsvr);\nEND;\nIF xsnewapprox(xsve,xsvr) THEN RETURN xsve; END;\nxsvr:=x"+
    "srewrite(xsvr);\nIF type(xsvr)==DOM_STRING THEN RETURN xsve; END;\nIF has(xsvr,undef) OR has(xsvr,infinity) THEN RETURN xs"+
    "ve; END;\nTHEN\nRETURN xsve;\nEND;\nRETURN xsvr;\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xstrans";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xstrans"; END;
  xsis:="(type((xsbounded(xsve,xsvdepth,xsvmatrix):=BEGIN\nLOCAL xsvb,xsvc,xsvk,xsvr,xsvsteps,xsvbest,xsvscore,xsvparent,xsvseen,x"+
    "svtext,xsvsafe;\nIF xsvdepth>=24 THEN RETURN xsve; END;\nIF type(xsve)==DOM_STRING THEN RETURN xsve; END;\nxsvsafe:=xsidaut"+
    "o(xsve);\nIF xsvsafe[2] OR (string(xsvsafe[1])<>string(xsve) AND xshypnatural(xsvsafe[1])) THEN RETURN xsvsafe[1]; END;\nx"+
    "sve:=xsvsafe[1];\nIF type(xsve)==DOM_LIST THEN\nxsvr:=mid([0],1,0); xsvparent:=string(xsve);\nFOR xsvk FROM 1 TO size(xsve)"+
    " DO\nIF string(xsve[xsvk])==xsvparent THEN\nxsvr:=append(xsvr,xsve[xsvk]);\nELSE\nxsvr:=append(xsvr,xsbounded(xsve[xsvk],xsv"+
    "depth+1,xsvmatrix));\nEND;\nEND;\nRETURN xsvr;\nEND;\nxsvb:=xsrewrite(xsmpauto(xsve));\nIF type(xsvb)<>DOM_SYMBOLIC THEN RETUR"+
    "N xsvb; END;\n\n\n\n\nIF xscomplexrad(xsvb) THEN\nxsvb:=xsradtrigunit(xsvb);\nIFERR\nxsvc:=ratnormal(xsvb);\nIF type(xsvc)<>DOM_S"+
    "TRING AND NOT has(xsvc,undef) AND NOT has(xsvc,infinity) AND NOT xsnewapprox(xsvb,xsvc) THEN\nxsvb:=xsradtrigunit(xsvc);\n"+
    "END;\nTHEN RETURN xsvb;\nEND;\nRETURN xsvb;\nEND;\nxsvtext:=string(xsvb); xsvseen:=[xsvtext];\nIF xsvmatrix THEN\nxsvbest:=size"+
    "(xsvtext); xsvsteps:=[1,2];\nELSE\nxsvbest:=20*xsweight(xsvb)+size(xsvtext); xsvsteps:=[1,2,5];\nEND;\nIF size(lname(xsve))="+
    "=0 THEN xsvsteps:=append(xsvsteps,6); END;\nFOR xsvk FROM 1 TO size(xsvsteps) DO\nxsvc:=xstrans(xsve,xsvsteps[xsvk]);\nIF t"+
    "ype(xsvc)<>DOM_STRING THEN\nIF type(xsvc)<>DOM_SYMBOLIC AND type(xsvc)<>DOM_LIST THEN RETURN xsvc; END;\nxsvtext:=string(x"+
    "svc);\nIF NOT member(xsvtext,xsvseen) THEN\nxsvseen:=append(xsvseen,xsvtext);\nIF xsvmatrix THEN xsvscore:=size(xsvtext);\nE"+
    "LSE xsvscore:=20*xsweight(xsvc)+size(xsvtext); END;\nIF xsvscore<xsvbest THEN xsvb:=xsvc; xsvbest:=xsvscore; END;\nEND;\nEN"+
    "D;\nEND;\nRETURN xsvb;\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsbounded";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsbounded"; END;
  xsis:="(type((xsscalar(xsve):=BEGIN RETURN xsbounded(xsve,0,0); END))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsscalar";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsscalar"; END;
  xsis:="(type((XFAST(xsve):=BEGIN\nIF type(xsinitok)<>DOM_FUNC THEN RETURN ""XSIMP 1.8.7: run XSIMPKIT187 from Program Catalog to "+
    "refresh CAS functions""; END;\nIF NOT xsinitok(0) THEN RETURN ""XSIMP 1.8.7: run XSIMPKIT187 from Program Catalog to refres"+
    "h CAS functions""; END;\nRETURN xsscalar(xsve);\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:XFAST";
  END;
  IF xsik<>1 THEN RETURN "stage:define:XFAST"; END;
  xsis:="(type((XREWRITE(xsve):=BEGIN\nIF type(xsinitok)<>DOM_FUNC THEN RETURN ""XSIMP 1.8.7: run XSIMPKIT187 from Program Catalog "+
    "to refresh CAS functions""; END;\nIF NOT xsinitok(0) THEN RETURN ""XSIMP 1.8.7: run XSIMPKIT187 from Program Catalog to ref"+
    "resh CAS functions""; END;\nRETURN xsrewrite(xsve);\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:XREWRITE";
  END;
  IF xsik<>1 THEN RETURN "stage:define:XREWRITE"; END;
  xsis:="(type((xsclean(xsve):=BEGIN RETURN xsbounded(xsve,0,1); END))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsclean";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsclean"; END;
  xsis:="(type((xsrectwalk(xsve,xsvdepth):=BEGIN\nLOCAL xsvk,xsvr,xsvparent;\nIF xsvdepth>=24 THEN RETURN xsve; END;\nIF type(xsve)="+
    "=DOM_LIST THEN\nxsvr:=mid([0],1,0); xsvparent:=string(xsve);\nFOR xsvk FROM 1 TO size(xsve) DO\nIF string(xsve[xsvk])==xsvp"+
    "arent THEN xsvr:=append(xsvr,xsve[xsvk]);\nELSE xsvr:=append(xsvr,xsrectwalk(xsve[xsvk],xsvdepth+1)); END;\nEND;\nRETURN xs"+
    "vr;\nEND;\nxsvr:=simplify(re(xsve))+i*simplify(im(xsve));\nIF xsnewapprox(xsve,xsvr) THEN RETURN xsve; END;\nRETURN xsvr;\nEN"+
    "D))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
