  IF xsik<>1 THEN RETURN "stage:define:xsidwalk"; END;
  xsis:="(type((xsidauto(xsie):=BEGIN\nLOCAL xsis;\nIF type(xsie)<>DOM_SYMBOLIC THEN RETURN [xsie,0]; END;\nxsis:=string(xsie);\nIF i"+
    "nString(xsis,""sin"")==0 AND inString(xsis,""cos"")==0 AND\ninString(xsis,""SIN"")==0 AND inString(xsis,""COS"")==0 AND\ninString("+
    "xsis,""(e^"")==0 AND inString(xsis,""(exp("")==0 AND\ninString(xsis,""(EXP("")==0 THEN RETURN [xsie,0]; END;\nIF size(xsis)>1600"+
    " OR xshypguard(xsie,0,768)<0 THEN RETURN [xsie,0]; END;\nIFERR RETURN xsidwalk(xsie,0); THEN RETURN [xsie,0]; END;\nEND))="+
