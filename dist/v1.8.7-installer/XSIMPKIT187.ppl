  xsis:="(type((xsuhypcandidate(xsue,xsud):=BEGIN\nLOCAL xsur,xsuk;\nIF xsud>=24 THEN RETURN xsue; END;\nIF type(xsue)<>DOM_LIST THE"+
    "N RETURN xshypcompact(xsue); END;\nxsur:=mid([0],1,0);\nFOR xsuk FROM 1 TO size(xsue) DO\nxsur:=append(xsur,xsuhypcandidate"+
