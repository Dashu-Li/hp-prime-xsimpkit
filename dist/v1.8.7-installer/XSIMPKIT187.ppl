    "(xsie); xsin:=string(xsih); xsil:=[op(xsie)];\nIF xsimode==1 AND (xsih==sin OR xsih==cos) THEN\nIF size(xsil)<>1 THEN RETU"+
    "RN 0; END;\nIF xsidpoly(xsil[1],xsid+1,3)==0 THEN RETURN 0; END;\nxsim:=xsidmono(xsil[1],0);\nIF xsim[1]==0 OR abs(xsim[2])"+
    ">8 OR size(xsim[3])+size(xsim[4])>6 THEN RETURN 0; END;\nRETURN 2;\nEND;\nIF xsin==""'^'"" OR xsin==""^"" THEN\nIF xsimode==3 TH"+
