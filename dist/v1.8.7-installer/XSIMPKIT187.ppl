  xsis:="(type((xsmpnonzero(xsmpe,xsmpdepth):=BEGIN\nLOCAL xsmpt,xsmph,xsmpl,xsmpk;\nIF xsmpdepth>=16 THEN RETURN 0; END;\nxsmpt:=ty"+
