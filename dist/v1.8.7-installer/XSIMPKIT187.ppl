  xsis:="(type((xsmpwalk(xsmpe,xsmpdepth,xsmpbudget,xsmpphase):=BEGIN\nLOCAL xsmpt,xsmph,xsmpl,xsmpk,xsmpcount,xsmpchild,xsmpmaxde"+
    "pth,xsmphead,xsmpchildphase;\nIF xsmpphase<>1 THEN xsmpmaxdepth:=12; ELSE xsmpmaxdepth:=16; END;\nxsmpchildphase:=xsmpphas"+
    "e;\nIF xsmpdepth>=xsmpmaxdepth OR xsmpbudget<1 THEN RETURN -1; END;\nxsmpt:=type(xsmpe);\nIF xsmpt==DOM_INT OR xsmpt==DOM_R"+
