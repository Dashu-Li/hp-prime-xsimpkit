    "IMP(""cosh(xsmpchecku+xsmpcheckv)-cos(i*xsmpchecku)*cosh(xsmpcheckv)+i*sin(i*xsmpchecku)*sinh(xsmpcheckv)""))<>""0"" THEN RE"+
    "TURN ""XSIMP 1.8: addition identity failed""; END;\nIF inString(string(XSIMP(""exp(xsmpchecku)-exp(-xsmpchecku)"")),""sinh("")="+
    "=0 THEN RETURN ""XSIMP 1.8: exponential pairing failed""; END;\nIF type(xsphold(""@@XSIMP_I@@""))<>DOM_COMPLEX THEN RETURN ""X"+
    "SIMP: exact complex literal parsing failed""; END;\nIF string(normal(-i*xsphold(""@@XSIMP_I@@*xsmpcheckv"")))<>""xsmpcheckv"" "+
