  xsis:="(type((xsmpunbound(xsmpe,xsmpdepth):=BEGIN\nLOCAL xsmpt,xsmpl,xsmpk,xsmpinfo;\nIF xsmpdepth>=12 THEN RETURN 0; END;\nxsmpt:"+
    "=type(xsmpe);\nIF xsmpt==DOM_IDENT THEN\nxsmpinfo:=about(xsmpe);\nRETURN type(xsmpinfo)==DOM_IDENT AND string(xsmpinfo)==st"+
