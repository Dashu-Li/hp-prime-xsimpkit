    "N\nIF xsmpl[2]<1 OR xsmpl[2]>8 THEN RETURN -1; END;\nxsmpchildphase:=2;\nELSE\nIF xsmpl[2]<-16 OR xsmpl[2]>16 THEN RETURN -1"+
    "; END;\nIF xsmpl[2]<=0 AND NOT xsmpnonzero(xsmpl[1],0) THEN RETURN -1; END;\nEND;\nELSE\nIF xsmphead==""'inv'"" OR xsmphead=="""+
    "inv"" THEN\nIF xsmpphase<>1 OR size(xsmpl)<>1 THEN RETURN -1; END;\nIF NOT xsmpnonzero(xsmpl[1],0) THEN RETURN -1; END;\nELS"+
