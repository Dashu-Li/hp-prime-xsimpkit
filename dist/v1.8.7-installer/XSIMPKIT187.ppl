    "2]==-xhpb[2] THEN xhpkind:=2; END;\nEND;\nIF xhpkind==2 AND xhpa[2]<0 AND xhpb[2]>0 THEN xhptmp:=xhpa; xhpa:=xhpb; xhpb:=x"+
