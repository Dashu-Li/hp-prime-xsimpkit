    RETURN "stage:verify:xsucorecheck";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:xsucorecheck"; END;
  xsis:="type(xsutree)==DOM_FUNC";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:verify:xsutree";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:xsutree"; END;
  xsis:="type(xsufold)==DOM_FUNC";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:verify:xsufold";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:xsufold"; END;
  xsis:="type(xsuhypcandidate)==DOM_FUNC";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:verify:xsuhypcandidate";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:xsuhypcandidate"; END;
  xsis:="type(xsuholefactor)==DOM_FUNC";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:verify:xsuholefactor";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:xsuholefactor"; END;
  xsis:="type(xsuholewalk)==DOM_FUNC";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:verify:xsuholewalk";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:xsuholewalk"; END;
  xsis:="type(xsuholegate)==DOM_FUNC";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:verify:xsuholegate";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:xsuholegate"; END;
  xsis:="type(xsuend)==DOM_FUNC";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:verify:xsuend";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:xsuend"; END;
  xsis:="type(xsuorigselect)==DOM_FUNC";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:verify:xsuorigselect";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:xsuorigselect"; END;
  xsis:="type(XSIMP)==DOM_FUNC";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:verify:XSIMP";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:XSIMP"; END;
  xsis:="type(XSDIAG)==DOM_FUNC";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:verify:XSDIAG";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:XSDIAG"; END;
  xsis:="type(XSCHECK)==DOM_FUNC";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:verify:XSCHECK";
  END;
  IF xsik<>1 THEN RETURN "stage:verify:XSCHECK"; END;
  xsis:="XSCHECK(0)";
  RETURN CAS.expr(xsis);
END;
