  IF xsik<>1 THEN RETURN "stage:define:xsmpwalk"; END;
  xsis:="(type((xsmptry(xsmpinput):=BEGIN\nLOCAL xsmporiginal,xsmpcurrent,xsmpcandidate,xsmpbest,\nxsmpbestscore,xsmpscore,xsmpstep"+
    ",xsmptext,xsmpseen;\nxsmporiginal:=xsmpinput;\nIFERR\n\nIF size(string(xsmporiginal))>256 THEN RETURN xsmporiginal; END;\nIF "+
