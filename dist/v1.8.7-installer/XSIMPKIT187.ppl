    "pl[2],0) THEN RETURN -1; END;\nELSE\nIF NOT member(xsmphead,[""'+'"",""+"",""'-'"",""-"",""'*'"",""*""]) THEN RETURN -1; END;\nIF size("+
    "xsmpl)==0 THEN RETURN -1; END;\nEND;\nEND;\nEND;\nEND;\nxsmpcount:=1;\nFOR xsmpk FROM 1 TO size(xsmpl) DO\nIF string(xsmpl[xsmp"+
