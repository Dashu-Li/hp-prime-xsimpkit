    "xsfothers,xsftext,xsfsgn,xsft;\nIF xsfd>=24 THEN RETURN [xsfe,xsfcache]; END;\nIF type(xsfe)==DOM_LIST THEN\nxsfr:=mid([0],"+
    "1,0);\nFOR xsfk FROM 1 TO size(xsfe) DO\nxsfv:=xspfwalk(xsfe[xsfk],xsfd+1,xsfcache); xsfcache:=xsfv[2]; xsfr:=append(xsfr,"+
    "xsfv[1]);\nEND;\nRETURN [xsfr,xsfcache];\nEND;\nIF type(xsfe)<>DOM_SYMBOLIC THEN RETURN [xsfe,xsfcache]; END;\nxsfkey:=string"+
    "(xsfe);\nIF size(xsfkey)>1600 THEN RETURN [xsfe,xsfcache]; END;\nIF xsidpoly(xsfe,0,0)==1 THEN\nFOR xsfk FROM 1 TO size(xsf"+
    "cache) DO\nIF xsfcache[xsfk][1]==xsfkey THEN RETURN [xsfcache[xsfk][2],xsfcache]; END;\nEND;\nxsfv:=xspfpoly(xsfe,0);\nIF si"+
    "ze(xsfcache)<24 AND size(xsfkey)>12 THEN xsfcache:=append(xsfcache,[xsfkey,xsfv]); END;\nRETURN [xsfv,xsfcache];\nEND;\nxsf"+
    "h:=xshead(xsfe); xsfn:=string(xsfh); xsfl:=[op(xsfe)];\nIF xspunaryname(xsfh)=="""" AND NOT member(xsfn,[""'+'"",""+"",""'-'"",""-"+
    """,""'*'"",""*"",""'/'"",""/"",""'inv'"",""inv"",""'^'"",""^""]) THEN RETURN [xsfe,xsfcache]; END;\nxsfr:=mid([0],1,0); xsfchanged:=0;\nFOR"+
    " xsfk FROM 1 TO size(xsfl) DO\nIF string(xsfl[xsfk])==xsfkey THEN RETURN [xsfe,xsfcache]; END;\nxsfv:=xspfwalk(xsfl[xsfk],"+
    "xsfd+1,xsfcache); xsfcache:=xsfv[2];\nxsfr:=append(xsfr,xsfv[1]);\nIF string(xsfv[1])<>string(xsfl[xsfk]) THEN xsfchanged:"+
    "=1; END;\nEND;\nxsfq:=xsfe;\nIF xsfchanged THEN xsfq:=xshyprebuild(xsfh,xsfr); END;\n\n\nIF member(xsfn,[""'+'"",""+"",""'-'"",""-""])"+
