    "mpbest))+"":""+string(xsmpbest)];\nFOR xsmpstep FROM 1 TO 3 DO\nIF type(xsmpcurrent)<>DOM_SYMBOLIC THEN RETURN xsmpbest; END"+
    ";\nIF xsmpstep==1 THEN xsmpcandidate:=hyp2exp(xsmpcurrent); END;\nIF xsmpstep==2 THEN xsmpcandidate:=trig2exp(xsmpcurrent)"+
    "; END;\nIF xsmpstep==3 THEN xsmpcandidate:=simplify(xsmpcurrent); END;\nIF type(xsmpcandidate)==DOM_STRING OR size(string("+
