  IF xsik<>1 THEN RETURN "stage:define:xsrectwalk"; END;
  xsis:="(type((XRECT(xsve):=BEGIN\nIF type(xsinitok)<>DOM_FUNC THEN RETURN ""XSIMP 1.8.7: run XSIMPKIT187 from Program Catalog to "+
    "refresh CAS functions""; END;\nIF NOT xsinitok(0) THEN RETURN ""XSIMP 1.8.7: run XSIMPKIT187 from Program Catalog to refres"+
    "h CAS functions""; END;\nRETURN xsrectwalk(xsve,0);\nEND))==DOM_FUNC)";
