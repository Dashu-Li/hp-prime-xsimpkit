    "'"" OR xsfn==""-"") AND (size(xsfl)==1 OR xsfk>1) THEN xsfs:=-xsfs; END;\nxsfv:=xspfterms(xsfl[xsfk],xsfd+1,xsfs);\nFOR xsfj "+
