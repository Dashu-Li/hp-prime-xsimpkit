    "\nRETURN xsuholefactor(xsul[1],xsud+1,xsub-1);\nEND;\nIF xsun==""'*'"" OR xsun==""*"" THEN\nxsur:=[1,1,mid([0],1,0)];\nFOR xsuk F"+
    "ROM 1 TO size(xsul) DO\nxsuv:=xsuholefactor(xsul[xsuk],xsud+1,xsub-xsur[2]); IF xsuv[1]==0 THEN RETURN [0]; END;\nxsur[2]:"+
    "=xsur[2]+xsuv[2];\nFOR xsuj FROM 1 TO size(xsuv[3]) DO IF NOT member(xsuv[3][xsuj],xsur[3]) THEN xsur[3]:=append(xsur[3],"+
