    "size(xsuinput) DO\n\n\nxsuarg:=xsuinput[xsuj]; xsupow:=xsuarg;\nIF type(xsuarg)!=DOM_LIST THEN xsupow:=xsppostscalar(xsuarg)"+
    "; END;\nIF string(xsupow)!=string(xsuarg) THEN\nxsuarg:=xsupow;\nELSE\nxsuarg:=xsutree0(xsuarg,xsulevel+1);\nIF type(xsuarg)="+
    "=DOM_STRING THEN RETURN xsuarg; END;\nIF type(xsuarg)!=DOM_LIST THEN\nxsuarg:=xsscalar(xsuarg);\n\nxsuarg:=xsppostscalar(xsu"+
    "arg);\nEND;\nEND;\nxsures:=append(xsures,xsuarg);\nEND;\nRETURN xsures;\nEND;\nIF type(xsuinput)==DOM_IDENT THEN\nxsuarg:=eval(x"+
    "suinput);\nIF xsumatrix(xsuarg) THEN RETURN xsutree0(xsuarg,xsulevel+1); END;\nRETURN xsuarg;\nEND;\nIF type(xsuinput)!=DOM_"+
    "SYMBOLIC THEN RETURN xsuinput; END;\nxsuhead:=xsuinput[1];\nIF type(xsuhead)!=DOM_FUNC THEN RETURN ""XSIMP: unsupported exp"+
    "ression operator""; END;\nIF string(xsuhead)==""of"" OR string(xsuhead)==""'of'"" THEN RETURN ""XSIMP: user function calls are "+
    "not supported in quoted input""; END;\n\nIF xsuhead==exp THEN\nxsuarg:=op(xsuinput);\nIF type(xsuarg)==DOM_SYMBOLIC THEN\nIF s"+
    "tring(xsuarg[1])==""'*'"" OR string(xsuarg[1])==""*"" THEN\nxsufact:=[op(xsuarg)]; xsucoef:=1; xsufound:=0; xsuscalar:=1;\nFOR"+
    " xsuj FROM 1 TO size(xsufact) DO\n\n\n\nxsupow:=xsutree0(xsufact[xsuj],xsulevel+2);\nIF type(xsupow)==DOM_STRING THEN\nxsuscal"+
    "ar:=0; xsupow:=xsutree0(xsufact[xsuj],xsulevel+1);\nEND;\nIF type(xsupow)==DOM_STRING THEN RETURN xsupow; END;\nxsufact[xsu"+
    "j]:=xsupow;\nIF type(xsupow)==DOM_LIST THEN xsuscalar:=0; END;\nIF xsumatrix(xsupow) THEN\nIF xsufound==0 THEN xsumat:=xsup"+
    "ow; xsufound:=1;\nELSE xsumat:=xsumat*xsupow; END;\nELSE xsucoef:=xsucoef*xsupow; END;\nEND;\nIF xsufound==1 THEN RETURN XEX"+
    "PT(xsumat,xsucoef); END;\nIF xsuscalar THEN\n\n\nxsupow:=xshead(xsuarg); xsupow:=xsupow(op(xsufact));\nIF xsnewapprox(xsuarg,"+
    "xsupow) THEN xsupow:=xsuarg; END;\nIF xsumatrix(xsupow) THEN RETURN XEXP(xsupow); END;\nxsupow:=xsuhead(xsupow);\nIF xsnewa"+
    "pprox(xsuinput,xsupow) THEN RETURN xsuinput; END;\nRETURN xsupow;\nEND;\nEND;\nEND;\nEND;\n\nIF xsuhead==exp OR xsuhead==sin OR"+
    " xsuhead==cos OR xsuhead==sinh OR xsuhead==cosh OR xsuhead==sqrt THEN\nIF string(op(xsuinput))==string(xsuinput) THEN RET"+
    "URN ""XSIMP: expression traversal did not progress""; END;\nxsuarg:=op(xsuinput);\nIF type(xsuarg)==DOM_LIST THEN xsuarg:=[x"+
    "suarg]; END;\nxsuarg:=xsutree0(xsuarg,xsulevel+1);\nIF type(xsuarg)==DOM_STRING THEN RETURN xsuarg; END;\nIF xsumatrix(xsua"+
    "rg) THEN\nIF xsuhead==exp THEN RETURN XEXP(xsuarg); END;\nIF xsuhead==sin THEN RETURN XSIN(xsuarg); END;\nIF xsuhead==cos T"+
    "HEN RETURN XCOS(xsuarg); END;\nIF xsuhead==sinh THEN RETURN (XEXP(xsuarg)-XEXP(-xsuarg))/2; END;\nIF xsuhead==cosh THEN RE"+
    "TURN (XEXP(xsuarg)+XEXP(-xsuarg))/2; END;\nEND;\nIF xsuhead==sqrt AND type(xsuarg)!=DOM_LIST THEN RETURN xsmroot(xsuarg); "+
    "END;\nxsupow:=xsuhead(xsuarg);\nIF xsnewapprox(xsuinput,xsupow) THEN RETURN xsuinput; END;\nRETURN xsupow;\nEND;\nxsulist:=[o"+
    "p(xsuinput)]; xsures:=mid([0],1,0);\nFOR xsuj FROM 1 TO size(xsulist) DO\nIF string(xsulist[xsuj])==string(xsuinput) THEN "+
    "RETURN ""XSIMP: expression traversal did not progress""; END;\nxsuarg:=xsutree0(xsulist[xsuj],xsulevel+1);\nIF type(xsuarg)="+
    "=DOM_STRING THEN RETURN xsuarg; END;\nxsures:=append(xsures,xsuarg);\nEND;\nIF string(xsuhead)==""'^'"" OR string(xsuhead)=="""+
    "^"" THEN\nIF size(xsures)==2 THEN\nxsuarg:=xsures[1]; xsupow:=xsures[2];\nIF xsumatrix(xsupow) THEN\nIF NOT xsumatrix(xsuarg)"+
    " THEN RETURN XPOW(xsuarg,xsupow); END;\nEND;\nIF type(xsupow)==DOM_RAT AND xsupow==1/2 AND type(xsuarg)!=DOM_LIST THEN RET"+
    "URN xsmroot(xsuarg); END;\nEND;\nEND;\nxsuarg:=xsuhead(op(xsures));\nIF xsnewapprox(xsuinput,xsuarg) THEN RETURN xsuinput; E"+
    "ND;\nRETURN xsuarg;\nEND))==DOM_FUNC)";
  IFERR
    xsik:=CAS.expr(xsis);
  THEN
    RETURN "stage:define:xsutree0";
  END;
  IF xsik<>1 THEN RETURN "stage:define:xsutree0"; END;
  xsis:="(type((xsuindexok(xsuunused):=BEGIN\n\nRETURN expr(""([17,23])[1]==17"");\nEND))==DOM_FUNC)";
