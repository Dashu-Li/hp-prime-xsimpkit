    "==""-1"" THEN\nxhpr:=xshypmono(xhpl[1],xhpd+1); IF xhpr[1]==0 OR xhpr[2]==0 THEN RETURN [0]; END;\nRETURN [1,1/xhpr[2],xhpr["+
    "4],xhpr[3],-xhpr[5],xhpr[6]];\nEND;\nIF xhpn==""'/'"" OR xhpn==""/"" THEN\nIF size(xhpl)<>2 THEN RETURN [0]; END;\nxhpa:=xshypmo"+
    "no(xhpl[1],xhpd+1); xhpb:=xshypmono(xhpl[2],xhpd+1);\nIF xhpa[1]==0 OR xhpb[1]==0 OR xhpb[2]==0 THEN RETURN [0]; END;\nxhp"+
    "r:=[1,xhpa[2]/xhpb[2],xhpa[3],xhpa[4],xhpa[5]-xhpb[5],xhpa[6]+xhpb[6]];\nFOR xhpj FROM 1 TO size(xhpb[4]) DO xhpr[3]:=app"+
    "end(xhpr[3],xhpb[4][xhpj]); END;\nFOR xhpj FROM 1 TO size(xhpb[3]) DO xhpr[4]:=append(xhpr[4],xhpb[3][xhpj]); END;\nRETURN"+
    " xhpr;\nEND;\nIF xhpn<>""'*'"" AND xhpn<>""*"" THEN RETURN [1,1,[xhpe],mid([0],1,0),0,0]; END;\nxhpr:=[1,1,mid([0],1,0),mid([0]"+
    ",1,0),0,0];\nFOR xhpk FROM 1 TO size(xhpl) DO\nxhpv:=xshypmono(xhpl[xhpk],xhpd+1); IF xhpv[1]==0 THEN RETURN [0]; END;\nxhp"+
    "r[2]:=xhpr[2]*xhpv[2]; xhpr[5]:=xhpr[5]+xhpv[5]; xhpr[6]:=xhpr[6]+xhpv[6];\nFOR xhpj FROM 1 TO size(xhpv[3]) DO xhpr[3]:="+
    "append(xhpr[3],xhpv[3][xhpj]); END;\nFOR xhpj FROM 1 TO size(xhpv[4]) DO xhpr[4]:=append(xhpr[4],xhpv[4][xhpj]); END;\nIF "+
    "xhpr[6]>8 OR size(xhpr[3])+size(xhpr[4])>32 THEN RETURN [0]; END;\nEND;\nRETURN xhpr;\nEND))==DOM_FUNC)";
