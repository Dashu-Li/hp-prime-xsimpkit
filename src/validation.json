{
  "runtime": "\"giac 1.5.0-63, (c) B. Parisse and R. De Graeve, Institut Fourier, Universite de Grenoble I\"",
  "testAdaptation": "HP one-based indices mechanically changed to desktop zero-based; #cas wrapper excluded. Not HP firmware execution.",
  "results": [
    {
      "name": "trig identity",
      "input": "XSIMP(\"sin(x)^2+cos(x)^2\")",
      "expected": "1",
      "actual": "1",
      "difference": "0",
      "passed": true,
      "ms": 293
    },
    {
      "name": "Euler cancellation",
      "input": "XSIMP(\"(exp(i)+exp(-i))/2-cos(1)\")",
      "expected": "0",
      "actual": "0",
      "difference": "0",
      "passed": true,
      "ms": 170
    },
    {
      "name": "rational cancellation",
      "input": "XSIMP(\"(x^2-1)/(x-1)\")",
      "expected": "x+1",
      "actual": "x+1",
      "difference": "0",
      "passed": true,
      "ms": 34
    },
    {
      "name": "complex rectangular",
      "input": "XSIMP(\"(1+i)/(1-i)\")",
      "expected": "i",
      "actual": "i",
      "difference": "0",
      "passed": true,
      "ms": 1
    },
    {
      "name": "irrational real exponent",
      "input": "XSIMP(\"exp((2-sqrt(3))*ln(2))\")",
      "expected": "2^(2-sqrt(3))",
      "actual": "2^(-(sqrt(3))+2)=1.20409497572",
      "difference": "2^(-(sqrt(3))+2)-2^(-√3+2)=0.0",
      "passed": true,
      "ms": 143
    },
    {
      "name": "retain complex exponential",
      "input": "XSIMP(\"exp(i*ln(2))\")",
      "expected": "exp(i*ln(2))",
      "actual": "exp(i*ln(2))=0.769238901364+0.638961276314*i",
      "difference": "0",
      "passed": true,
      "ms": 21
    },
    {
      "name": "complex special angle",
      "input": "XSIMP(\"exp(i*pi/3)\")",
      "expected": "(1+i*sqrt(3))/2",
      "actual": "(i*sqrt(3)+1)/2=0.5+0.866025403784*i",
      "difference": "0",
      "passed": true,
      "ms": 180
    },
    {
      "name": "list map",
      "input": "XSIMP(\"[sin(x)^2+cos(x)^2,(x^2-1)/(x-1)]\")",
      "expected": "[1,x+1]",
      "actual": "[1,x+1]",
      "difference": "[0,0]",
      "passed": true,
      "ms": 7
    },
    {
      "name": "matrix zero power",
      "input": "XSIMP(\"2^[[0,0],[0,0]]\")",
      "expected": "[[1,0],[0,1]]",
      "actual": "[[1,0],[0,1]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 11
    },
    {
      "name": "rotation exp",
      "input": "XSIMP(\"exp([[0,-1],[1,0]])\")",
      "expected": "[[cos(1),-sin(1)],[sin(1),cos(1)]]",
      "actual": "[[cos(1),-sin(1)],[sin(1),cos(1)]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 21
    },
    {
      "name": "rotation parameter",
      "input": "XSIMP(\"exp(t*[[0,-1],[1,0]])\")",
      "expected": "[[cos(t),-sin(t)],[sin(t),cos(t)]]",
      "actual": "[[cos(t),-sin(t)],[sin(t),cos(t)]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 5
    },
    {
      "name": "parameter at zero",
      "input": "subst(XSIMP(\"exp(t*[[0,-1],[1,0]])\"),t,0)",
      "expected": "[[1,0],[0,1]]",
      "actual": "[[1,0],[0,1]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 6
    },
    {
      "name": "base two rotation",
      "input": "XSIMP(\"2^[[0,-1],[1,0]]\")",
      "expected": "[[cos(ln(2)),-sin(ln(2))],[sin(ln(2)),cos(ln(2))]]",
      "actual": "[[cos(ln(2)),-sin(ln(2))],[sin(ln(2)),cos(ln(2))]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 8
    },
    {
      "name": "Jordan exp",
      "input": "XSIMP(\"exp([[2,1],[0,2]])\")",
      "expected": "exp(2)*[[1,1],[0,1]]",
      "actual": "[[exp(2),exp(2)],[0,exp(2)]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 4
    },
    {
      "name": "Jordan power",
      "input": "XSIMP(\"2^[[2,1],[0,2]]\")",
      "expected": "[[4,4*ln(2)],[0,4]]",
      "actual": "[[4,4*ln(2)],[0,4]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 4
    },
    {
      "name": "3x3 nilpotent",
      "input": "XSIMP(\"exp([[0,1,0],[0,0,1],[0,0,0]])\")",
      "expected": "[[1,1,1/2],[0,1,1],[0,0,1]]",
      "actual": "[[1,1,1/2],[0,1,1],[0,0,1]]",
      "difference": "[[0,0,0],[0,0,0],[0,0,0]]",
      "passed": true,
      "ms": 5
    },
    {
      "name": "matrix sine",
      "input": "XSIMP(\"sin([[0,-1],[1,0]])\")",
      "expected": "[[0,-sinh(1)],[sinh(1),0]]",
      "actual": "[[0,-sinh(1)],[sinh(1),0]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 8
    },
    {
      "name": "matrix cosine",
      "input": "XSIMP(\"cos([[0,-1],[1,0]])\")",
      "expected": "[[cosh(1),0],[0,cosh(1)]]",
      "actual": "[[cosh(1),0],[0,cosh(1)]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 4
    },
    {
      "name": "matrix hyperbolic cosine",
      "input": "XSIMP(\"cosh([[0,-1],[1,0]])\")",
      "expected": "[[cos(1),0],[0,cos(1)]]",
      "actual": "[[cos(1),0],[0,cos(1)]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 7
    },
    {
      "name": "nested matrix sum",
      "input": "XSIMP(\"exp([[0,-1],[1,0]])+exp([[0,1],[-1,0]])\")",
      "expected": "2*cos(1)*[[1,0],[0,1]]",
      "actual": "[[2*cos(1),0],[0,2*cos(1)]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 9
    },
    {
      "name": "ordinary matrix square",
      "input": "XSIMP(\"[[1,1],[2,3]]^2\")",
      "expected": "[[3,4],[8,11]]",
      "actual": "[[3,4],[8,11]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 3
    },
    {
      "name": "explicit elementwise power",
      "input": "XSIMP(\"2 .^ [[1,1],[2,3]]\")",
      "expected": "[[2,2],[4,8]]",
      "actual": "[[2,2],[4,8]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 5
    },
    {
      "name": "diagonal power",
      "input": "XSIMP(\"2^[[1,0],[0,3]]\")",
      "expected": "[[2,0],[0,8]]",
      "actual": "[[2,0],[0,8]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 2
    },
    {
      "name": "symbol j not shadowed",
      "input": "XSIMP(\"exp([[j,1],[0,j]])\")",
      "expected": "exp(j)*[[1,1],[0,1]]",
      "actual": "[[exp(j),exp(j)],[0,exp(j)]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 5
    },
    {
      "name": "ordinary argument",
      "input": "XSIMP(sin(x)^2+cos(x)^2)",
      "expected": "1",
      "actual": "1",
      "difference": "0",
      "passed": true,
      "ms": 2
    },
    {
      "name": "single quoted matrix argument",
      "input": "XSIMP('2^[[0,0],[0,0]]')",
      "expected": "[[1,0],[0,1]]",
      "actual": "[[1,0],[0,1]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 2
    },
    {
      "name": "user original matrix",
      "input": "XSIMP(\"2^[[1,1],[2,3]]\")",
      "expected": "(2^(2+sqrt(3))+2^(2-sqrt(3)))/2*[[1,0],[0,1]]+(2^(2+sqrt(3))-2^(2-sqrt(3)))/(2*sqrt(3))*[[-1,1],[2,1]]",
      "actual": "[[4*((-sinh(sqrt(3)*ln(2)))/(sqrt(3))+cosh(sqrt(3)*ln(2))),4/(sqrt(3))*sinh(sqrt(3)*ln(2))],[8*sinh(sqrt(3)*ln(2))/(sqrt(3)),4*(sinh(sqrt(3)*ln(2))/(sqrt(3))+cosh(sqrt(3)*ln(2)))]]",
      "difference": "[[(-√3-3)/6*2^(-√3+2)+(√3-3)/6*2^(√3+2)+4*cosh(√3*ln(2))+(-4*√3/3)*sinh(√3*ln(2)),√3/6*2^(-√3+2)+(-√3/6)*2^(√3+2)+4*√3/3*sinh(√3*ln(2))],[√3/3*2^(-√3+2)+(-√3/3)*2^(√3+2)+8*√3/3*sinh(√3*ln(2)),(√3-3)/6*2^(-√3+2)+(-√3-3)/6*2^(√3+2)+4*cosh(√3*ln(2))+4*√3/3*sinh(√3*ln(2))]]",
      "passed": true,
      "ms": 96
    },
    {
      "name": "matrix Euler cancellation",
      "input": "XSIMP(\"[[(exp(i)+exp(-i))/2-cos(1),0],[0,1]]\")",
      "expected": "[[0,0],[0,1]]",
      "actual": "[[0,0],[0,1]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 9
    },
    {
      "name": "matrix containing scalar identity",
      "input": "XSIMP(\"[[sin(x)^2+cos(x)^2,0],[0,1]]\")",
      "expected": "[[1,0],[0,1]]",
      "actual": "[[1,0],[0,1]]",
      "difference": "[[0,0],[0,0]]",
      "passed": true,
      "ms": 3
    }
  ],
  "observations": [
    {
      "name": "native scalar base power",
      "input": "2^testmatrix",
      "actual": "[[2,2],[4,8]]"
    },
    {
      "name": "native matrix power",
      "input": "testmatrix^2",
      "actual": "[[3,4],[8,11]]"
    },
    {
      "name": "native zero matrix",
      "input": "2^[[0,0],[0,0]]",
      "actual": "[[1,1],[1,1]]"
    },
    {
      "name": "native genuine exp zero",
      "input": "exp(ln(2)*[[0,0],[0,0]])",
      "actual": "[[1,0],[0,1]]"
    },
    {
      "name": "head e power",
      "input": "(quote(e^a))[0]",
      "actual": "'exp'"
    },
    {
      "name": "head base two power",
      "input": "(quote(2^a))[0]",
      "actual": "'^'"
    },
    {
      "name": "bound matrix variable",
      "input": "XSIMP(\"2^testmatrix\")",
      "actual": "[[4*((-sinh(sqrt(3)*ln(2)))/(sqrt(3))+cosh(sqrt(3)*ln(2))),4/(sqrt(3))*sinh(sqrt(3)*ln(2))],[8*sinh(sqrt(3)*ln(2))/(sqrt(3)),4*(sinh(sqrt(3)*ln(2))/(sqrt(3))+cosh(sqrt(3)*ln(2)))]]"
    },
    {
      "name": "negative base rejection",
      "input": "XSIMP(\"(-2)^testmatrix\")",
      "actual": "\"XPOW requires a provably positive real base\""
    },
    {
      "name": "complex assumptions",
      "input": "complex_variables(1)",
      "actual": "1"
    },
    {
      "name": "complex exponent stays exponential",
      "input": "XSIMP(\"exp(z*ln(2))\")",
      "actual": "exp(z*ln(2))"
    },
    {
      "name": "complex variables reset",
      "input": "complex_variables(0)",
      "actual": "0"
